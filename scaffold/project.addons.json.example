{
  "APP_NAME": "Example Application With Add-ons",
  "APP_SLUG": "example-app",
  "DESCRIPTION": "Django application deployed behind Apache with Keycloak identity.",
  "REPOSITORY_URL": "https://github.com/BU-ISCIII/example-app.git",
  "DEFAULT_BRANCH": "main",
  "PYTHON_VERSION": "3.11",
  "TIMEZONE": "Europe/Madrid",
  "SERVICES": {
    "app": {
      "PROFILE": "django",
      "BUILD_CONTEXT": ".",
      "DOCKERFILE": "Dockerfile",
      "IMAGE": "example-app:local",
      "INSTALL_CONF": "conf/docker_production_settings.txt",
      "TEST_INSTALL_CONF": "conf/docker_test_settings.txt",
      "PROJECT_MODULE": "example_app",
      "API": true
    }
  },
  "ADDONS": {
    "apache": {
      "CONFIG_SERVICE": "app",
      "MOUNTS": []
    },
    "keycloak": {
      "CONFIG_SERVICE": "app"
    }
  }
}
