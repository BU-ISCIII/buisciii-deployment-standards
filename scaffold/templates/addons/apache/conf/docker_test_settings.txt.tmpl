# Apache add-on
# Used only when ADDONS.apache selects this application as CONFIG_SERVICE.

# Sources under <repository>/conf/apache are rendered into deployment/apache.
# This compatibility value is unused unless application code consumes it.
APACHE_CONF_PATH=''

# Disposable test logs and a loopback-only public endpoint.
APACHE_LOG_PATH='/tmp/{{APP_SLUG}}/apache-logs'
APACHE_BIND_HOST='127.0.0.1'
APACHE_PORT='8081'

# Default local VirtualHost. Empty upstream values are derived from the
# add-on's CONFIG_SERVICE by container_install.sh.
APACHE_SERVER_NAME='localhost'
APACHE_UPSTREAM_SERVICE=''
APACHE_UPSTREAM_PORT=''
APACHE_PROXY_TIMEOUT=''
APACHE_LOG_STEM=''

# Local server-status defaults.
SERVER_STATUS_SERVER_NAME='localhost'
SERVER_STATUS_ALIASES='127.0.0.1 localhost'
SERVER_STATUS_ALLOW_FROM='127.0.0.1 localhost'

# Test proxy headers and request-body limit.
APACHE_FORWARDED_PROTO='http'
APACHE_FORWARDED_PORT='8081'
APACHE_LIMIT_REQUEST_BODY='52428800'
