{
  "realm": "${KEYCLOAK_REALM}",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "clientSessionIdleTimeout": 28800,
  "clientSessionMaxLifespan": 86400,
  "accessTokenLifespan": 900,
  "actionTokenGeneratedByAdminLifespan": 86400,
  "actionTokenGeneratedByUserLifespan": 7200,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "smtpServer": {
    "host": "${KEYCLOAK_SMTP_HOST}",
    "port": "${KEYCLOAK_SMTP_PORT}",
    "from": "${KEYCLOAK_SMTP_FROM}",
    "fromDisplayName": "${KEYCLOAK_SMTP_FROM_DISPLAY_NAME}",
    "replyTo": "${KEYCLOAK_SMTP_REPLY_TO}",
    "replyToDisplayName": "${KEYCLOAK_SMTP_REPLY_TO_DISPLAY_NAME}",
    "envelopeFrom": "${KEYCLOAK_SMTP_ENVELOPE_FROM}",
    "auth": "${KEYCLOAK_SMTP_AUTH}",
    "ssl": "${KEYCLOAK_SMTP_SSL}",
    "starttls": "${KEYCLOAK_SMTP_STARTTLS}",
    "allowUtf8": "${KEYCLOAK_SMTP_ALLOW_UTF8}",
    "connectionTimeout": "${KEYCLOAK_SMTP_CONNECTION_TIMEOUT}",
    "timeout": "${KEYCLOAK_SMTP_TIMEOUT}",
    "writeTimeout": "${KEYCLOAK_SMTP_WRITE_TIMEOUT}",
    "user": "${KEYCLOAK_SMTP_USER}",
    "password": "${KEYCLOAK_SMTP_PASSWORD}"
  },
  "emailTheme": "${KEYCLOAK_EMAIL_THEME}",
  "groups": [],
  "clientScopes": [],
  "clients": [],
  "users": []
}
