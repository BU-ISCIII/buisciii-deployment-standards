  # BEGIN BU-ISCIII ADDON: keycloak
  {{APP_SLUG}}-keycloak-db:
    image: docker.io/library/mysql:8.0
    command: --default-authentication-plugin=mysql_native_password
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: ${KEYCLOAK_DB_NAME:-keycloak}
      MYSQL_USER: ${KEYCLOAK_DB_USER:-keycloak}
      MYSQL_PASSWORD: ${KEYCLOAK_DB_PASSWORD:?KEYCLOAK_DB_PASSWORD is required}
      MYSQL_ROOT_PASSWORD: ${KEYCLOAK_DB_ROOT_PASSWORD:?KEYCLOAK_DB_ROOT_PASSWORD is required}
    expose: ["3306"]
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u$$MYSQL_USER -p$$MYSQL_PASSWORD --silent"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 30s
    volumes:
      # REQUIRED persistent identity database. This is the primary Keycloak
      # state and MUST be included in backup/restore procedures.
      - keycloak_db_data:/var/lib/mysql
    networks: [deployment_net]

  {{APP_SLUG}}-keycloak:
    image: quay.io/keycloak/keycloak:26.6.1
    command: ["start", "--import-realm"]
    restart: unless-stopped
    depends_on:
      {{APP_SLUG}}-keycloak-db:
        condition: service_healthy
    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: ${KEYCLOAK_ADMIN:-admin}
      KC_BOOTSTRAP_ADMIN_PASSWORD: ${KEYCLOAK_ADMIN_PASSWORD:?KEYCLOAK_ADMIN_PASSWORD is required}
      KC_DB: mysql
      KC_DB_URL: jdbc:mysql://{{APP_SLUG}}-keycloak-db:3306/${KEYCLOAK_DB_NAME:-keycloak}?useSSL=false&allowPublicKeyRetrieval=true
      KC_DB_USERNAME: ${KEYCLOAK_DB_USER:-keycloak}
      KC_DB_PASSWORD: ${KEYCLOAK_DB_PASSWORD:?KEYCLOAK_DB_PASSWORD is required}
      KC_HEALTH_ENABLED: "true"
      KC_HOSTNAME: ${KEYCLOAK_PUBLIC_URL:?KEYCLOAK_PUBLIC_URL is required}
      KC_HOSTNAME_STRICT: "true"
      KC_HTTP_ENABLED: "true"
      KC_PROXY_HEADERS: xforwarded
    expose: ["8080"]
    ports:
      # Loopback publishing supports direct diagnostics; Apache remains the
      # normal public route. Remove only when another documented path exists.
      - "127.0.0.1:${KEYCLOAK_PORT:-8081}:8080"
    healthcheck:
      test: ["CMD-SHELL", "bash -ec '</dev/tcp/127.0.0.1/8080'"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 90s
    volumes:
      # REQUIRED reproducible realm import bind. Keycloak imports it only when
      # the realm is absent, normally on a fresh keycloak_db_data volume.
      - ${KEYCLOAK_IMPORT_PATH:-./keycloak/tmp-import}:/opt/keycloak/data/import:ro,z
      # OPTIONAL provider/theme mounts for multi-app deployments, when needed:
      # - ${KEYCLOAK_PROVIDER_PATH}:/opt/keycloak/providers:ro,z
      # - ${KEYCLOAK_THEME_PATH}:/opt/keycloak/themes/custom:ro,z
    networks: [deployment_net]
  # END BU-ISCIII ADDON: keycloak
