### Application-side Keycloak Admin REST API client
# Generated only when ADDONS.keycloak.ADMIN_ACCESS is true. Test values are disposable.
# Internal Compose URL for the Keycloak service. Example: http://keycloak:8080
KEYCLOAK_ADMIN_API_BASE_URL='http://keycloak:8080'
# Disposable realm managed by the application. Example: test
KEYCLOAK_ADMIN_API_REALM='test'
# Realm used to obtain the admin access token. Example: master
KEYCLOAK_ADMIN_API_TOKEN_REALM='master'
# OAuth client used for admin-token requests. Example: admin-cli
KEYCLOAK_ADMIN_API_CLIENT_ID='admin-cli'
# Optional confidential-client secret; empty in the disposable test stack.
KEYCLOAK_ADMIN_API_CLIENT_SECRET=''
# Disposable bootstrap administrator username. Example: admin
KEYCLOAK_ADMIN_API_USERNAME='admin'
# Disposable bootstrap administrator password. Example: admin
KEYCLOAK_ADMIN_API_PASSWORD='admin'
# Timeout in seconds for Keycloak Admin REST API requests. Example: 10
KEYCLOAK_ADMIN_API_TIMEOUT_SECONDS='10'
# Disable real action-email delivery in disposable tests. Example: false
KEYCLOAK_ADMIN_API_SEND_ACTION_EMAILS='false'
# Optional absolute redirect URI for required-action emails; empty in tests.
KEYCLOAK_ADMIN_API_ACTION_EMAIL_REDIRECT_URI=''
