# Keycloak add-on
# Used only when ADDONS.keycloak selects this application as CONFIG_SERVICE.

# Persistent database/schema name. Example: keycloak
KEYCLOAK_DB_NAME='keycloak'
# Least-privilege database user. Example: keycloak
KEYCLOAK_DB_USER='keycloak'
# Database-user password (secret). Example: a long random password.
KEYCLOAK_DB_PASSWORD='CHANGE_ME'
# Database initialization root password (secret). Use a different random value.
KEYCLOAK_DB_ROOT_PASSWORD='CHANGE_ME'

# Exact browser-facing URL routed by Apache. Example: https://auth.example.org
KEYCLOAK_PUBLIC_URL='https://CHANGE_ME_KEYCLOAK_DNS'
# Host loopback diagnostic port; Keycloak listens on 8080 in Compose. Example: 8081
KEYCLOAK_PORT='8081'

# Bootstrap administrator created only for an empty database. Example: admin
KEYCLOAK_ADMIN='admin'
# Bootstrap administrator password (secret). Example: a long random password.
KEYCLOAK_ADMIN_PASSWORD='CHANGE_ME'

# Repository-owned realm template rendered before Keycloak starts.
KEYCLOAK_REALM_TEMPLATE_PATH='./conf/keycloak/realm-production.json'
# Realm name used by the import filename and OIDC consumers. Example: institutional
KEYCLOAK_REALM='CHANGE_ME_REALM'
# Deployment-owned read-only bind staging. Realm JSON does not replace a
# database backup. Example: /srv/containers/bind/{{APP_SLUG}}/keycloak/realm-import
KEYCLOAK_IMPORT_PATH='/srv/containers/bind/{{APP_SLUG}}/keycloak/realm-import'

# Realm SMTP configuration. The endpoint must be reachable from Keycloak.
KEYCLOAK_SMTP_HOST='CHANGE_ME_SMTP_HOST'
KEYCLOAK_SMTP_PORT='25'
KEYCLOAK_SMTP_FROM='CHANGE_ME_FROM_EMAIL'
KEYCLOAK_SMTP_FROM_DISPLAY_NAME='Application'
KEYCLOAK_SMTP_REPLY_TO='CHANGE_ME_REPLY_TO_EMAIL'
KEYCLOAK_SMTP_REPLY_TO_DISPLAY_NAME='Application support'
KEYCLOAK_SMTP_ENVELOPE_FROM='CHANGE_ME_FROM_EMAIL'
KEYCLOAK_SMTP_AUTH='false'
KEYCLOAK_SMTP_SSL='false'
KEYCLOAK_SMTP_STARTTLS='false'
KEYCLOAK_SMTP_ALLOW_UTF8='true'
KEYCLOAK_SMTP_CONNECTION_TIMEOUT='10000'
KEYCLOAK_SMTP_TIMEOUT='10000'
KEYCLOAK_SMTP_WRITE_TIMEOUT='10000'
KEYCLOAK_SMTP_USER=''
KEYCLOAK_SMTP_PASSWORD=''
# Built-in theme name or an application-provided theme mounted in Keycloak.
KEYCLOAK_EMAIL_THEME='keycloak'
