  # BEGIN BU-ISCIII ADDON: mailpit
  {{APP_SLUG}}-mailpit:
    image: axllent/mailpit:v1.27
    restart: unless-stopped
    ports:
      - "127.0.0.1:${MAILPIT_SMTP_PORT:-1025}:1025"
      - "127.0.0.1:${MAILPIT_WEB_PORT:-8025}:8025"
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1:8025/livez || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 10s
    # Keep the SMTP hostname independent from the Compose project slug. Django
    # and Keycloak test settings can consistently use mailpit:1025.
    networks:
      deployment_net:
        aliases:
          - mailpit
  # END BU-ISCIII ADDON: mailpit
