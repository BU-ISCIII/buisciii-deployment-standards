  # BEGIN BU-ISCIII ADDON: nextstrain
  {{APP_SLUG}}_nextstrain:
    image: ${NEXTSTRAIN_IMAGE:-nextstrain:local}
    build:
      context: ${NEXTSTRAIN_BUILD_CONTEXT:-./nextstrain}
      dockerfile: ${NEXTSTRAIN_DOCKERFILE:-Dockerfile}
      args:
        MAPBOX_ACCESS_TOKEN: ${MAPBOX_ACCESS_TOKEN:?MAPBOX_ACCESS_TOKEN is required}
        MAPBOX_STYLE_OWNER: ${MAPBOX_STYLE_OWNER:-mapbox}
        MAPBOX_STYLE_ID: ${MAPBOX_STYLE_ID:-light-v11}
    restart: unless-stopped
    environment:
      HOST: "0.0.0.0"
      PORT: ${NEXTSTRAIN_PORT:-8100}
    expose:
      - "${NEXTSTRAIN_PORT:-8100}"
    ports:
      - "127.0.0.1:${NEXTSTRAIN_HOST_PORT:-8100}:${NEXTSTRAIN_PORT:-8100}"
    healthcheck:
      test: ["CMD", "python", "-c", "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ['PORT'] + '/', timeout=3)"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 30s
    volumes:
      - nextstrain_data:${NEXTSTRAIN_DATA_DIR:-/data}
      - /etc/localtime:/etc/localtime:ro
      - /usr/share/zoneinfo:/usr/share/zoneinfo:ro
    networks: [deployment_net]
  # END BU-ISCIII ADDON: nextstrain
