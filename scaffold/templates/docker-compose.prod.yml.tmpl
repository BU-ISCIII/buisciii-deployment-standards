services:
  app:
    build:
      context: .
      args:
        GIT_REVISION: ${GIT_REVISION:-current}
        INSTALL_CONF: ${BUILD_INSTALL_CONF:-conf/docker_production_settings.txt}
        APP_UID: ${APP_UID:-{{APP_UID}}}
        APP_GID: ${APP_GID:-{{APP_GID}}}
    restart: unless-stopped
    environment:
      APP_MODE: prod
      APP_INSTALL_PATH: {{INSTALL_PATH}}
      INSTALL_PATH: {{INSTALL_PATH}}
      APP_PORT: ${APP_PORT:-{{APP_PORT}}}
      PROJECT_MODULE: {{PROJECT_MODULE}}
      DJANGO_DEBUG: "false"
      DB_HOST: ${DB_HOST:?DB_HOST is required}
      DB_PORT: ${DB_PORT:-3306}
      DB_NAME: ${DB_NAME:?DB_NAME is required}
      DB_USER: ${DB_USER:?DB_USER is required}
      DB_PASSWORD: ${DB_PASSWORD:?DB_PASSWORD is required}
      DJANGO_SECRET_KEY: ${DJANGO_SECRET_KEY:?DJANGO_SECRET_KEY is required}
      DJANGO_ALLOWED_HOSTS: ${DJANGO_ALLOWED_HOSTS:?DJANGO_ALLOWED_HOSTS is required}
      DJANGO_CSRF_TRUSTED_ORIGINS: ${DJANGO_CSRF_TRUSTED_ORIGINS:?DJANGO_CSRF_TRUSTED_ORIGINS is required}
      EMAIL_HOST: ${EMAIL_HOST:-}
      EMAIL_PORT: ${EMAIL_PORT:-587}
      EMAIL_HOST_USER: ${EMAIL_HOST_USER:-}
      EMAIL_HOST_PASSWORD: ${EMAIL_HOST_PASSWORD:-}
      EMAIL_USE_TLS: ${EMAIL_USE_TLS:-true}
      WEB_CONCURRENCY: ${WEB_CONCURRENCY:-2}
      GUNICORN_THREADS: ${GUNICORN_THREADS:-2}
      GUNICORN_TIMEOUT: ${GUNICORN_TIMEOUT:-120}
      GUNICORN_KEEPALIVE: ${GUNICORN_KEEPALIVE:-5}
    user: "${APP_UID:-{{APP_UID}}}:${APP_GID:-{{APP_GID}}}"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "127.0.0.1:${APP_PORT:-{{APP_PORT}}}:{{APP_PORT}}"
    volumes:
      - ${HOST_DATA_PATH:-{{HOST_DATA_PATH}}}/documents:{{INSTALL_PATH}}/documents:Z
      - ${HOST_LOG_PATH:-{{HOST_LOG_PATH}}}:{{INSTALL_PATH}}/logs:Z
      - app_static:{{INSTALL_PATH}}/static:z
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{APP_PORT}}/health/', timeout=3)"]
      interval: 30s
      timeout: 5s
      start_period: 30s
      retries: 3
    networks: [app_net]

networks:
  app_net:

volumes:
  app_static:
