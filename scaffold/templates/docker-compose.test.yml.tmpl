services:
  db:
    image: docker.io/library/mysql:8.0
    restart: unless-stopped
    command: --default-authentication-plugin=mysql_native_password
    environment:
      MYSQL_DATABASE: ${DB_NAME:-{{PROJECT_MODULE}}}
      MYSQL_USER: ${DB_USER:-django}
      MYSQL_PASSWORD: ${DB_PASSWORD:-djangopass}
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:-root}
    ports:
      - "127.0.0.1:${DB_PORT_HOST:-{{DB_PORT_HOST}}}:3306"
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uroot -p$$MYSQL_ROOT_PASSWORD --silent"]
      interval: 5s
      timeout: 5s
      retries: 20
    volumes:
      - test_db:/var/lib/mysql
    networks: [app_net]

  app:
    build:
      context: .
      args:
        GIT_REVISION: ${GIT_REVISION:-current}
        INSTALL_CONF: ${BUILD_INSTALL_CONF:-conf/docker_test_settings.txt}
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      APP_MODE: dev
      APP_INSTALL_PATH: {{INSTALL_PATH}}
      INSTALL_PATH: {{INSTALL_PATH}}
      APP_PORT: {{APP_PORT}}
      PROJECT_MODULE: {{PROJECT_MODULE}}
      DB_HOST: db
      DB_PORT: 3306
      DB_NAME: ${DB_NAME:-{{PROJECT_MODULE}}}
      DB_USER: ${DB_USER:-django}
      DB_PASSWORD: ${DB_PASSWORD:-djangopass}
      DJANGO_DEBUG: "true"
      DJANGO_SECRET_KEY: ${DJANGO_SECRET_KEY:-test-only-change-me}
      DJANGO_ALLOWED_HOSTS: ${DJANGO_ALLOWED_HOSTS:-localhost,127.0.0.1,0.0.0.0}
    ports:
      - "127.0.0.1:${APP_PORT:-{{APP_PORT}}}:{{APP_PORT}}"
    volumes:
      - test_documents:{{INSTALL_PATH}}/documents:z
      - test_static:{{INSTALL_PATH}}/static:z
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{APP_PORT}}/health/', timeout=3)"]
      interval: 10s
      timeout: 5s
      retries: 12
    networks: [app_net]

networks:
  app_net:

volumes:
  test_db:
  test_documents:
  test_static:
