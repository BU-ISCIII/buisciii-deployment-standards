  {{SERVICE_NAME}}-db:
    image: docker.io/library/mysql:8.0
    command: --default-authentication-plugin=mysql_native_password
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: ${{{ENV_PREFIX}}_DB_NAME:?{{ENV_PREFIX}}_DB_NAME is required}
      MYSQL_USER: ${{{ENV_PREFIX}}_DB_USER:?{{ENV_PREFIX}}_DB_USER is required}
      MYSQL_PASSWORD: ${{{ENV_PREFIX}}_DB_PASSWORD:?{{ENV_PREFIX}}_DB_PASSWORD is required}
      MYSQL_RANDOM_ROOT_PASSWORD: "yes"
    expose: ["3306"]
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u$$MYSQL_USER -p$$MYSQL_PASSWORD --silent"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 30s
    volumes: [{{SERVICE_NAME}}_db_data:/var/lib/mysql]
    networks: [deployment_net]
