  {{PROJECT_MODULE}}_app_db:
    image: docker.io/library/mysql:8.0
    environment:
      MYSQL_DATABASE: ${{{ENV_PREFIX}}_DB_NAME:?{{ENV_PREFIX}}_DB_NAME is required}
      MYSQL_USER: ${{{ENV_PREFIX}}_DB_USER:?{{ENV_PREFIX}}_DB_USER is required}
      MYSQL_PASSWORD: ${{{ENV_PREFIX}}_DB_PASSWORD:?{{ENV_PREFIX}}_DB_PASSWORD is required}
      MYSQL_ROOT_PASSWORD: ${{{ENV_PREFIX}}_DB_ROOT_PASSWORD:?{{ENV_PREFIX}}_DB_ROOT_PASSWORD is required}
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uroot -p$$MYSQL_ROOT_PASSWORD --silent"]
      interval: 5s
      timeout: 5s
      retries: 20
    volumes: [{{SERVICE_NAME}}_test_db:/var/lib/mysql]
    networks: [deployment_net]
