    container_id="$(resolve_service_container {{SERVICE_NAME_SHELL}})"
    [ -n "$container_id" ] || fail "Service {{SERVICE_NAME}} has no container"
    ensure_service_running {{SERVICE_NAME_SHELL}} "$container_id" >/dev/null
    engine_exec exec "$container_id" bash -lc 'cd "$INSTALL_PATH" && source virtualenv/bin/activate && python manage.py check && ! python manage.py showmigrations --plan | grep -F '"'"'[ ]'"'"''
    echo "PASS: {{SERVICE_NAME}} Django checks and migrations"
