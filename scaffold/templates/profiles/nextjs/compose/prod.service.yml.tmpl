  # BEGIN BU-ISCIII SERVICE: {{SERVICE_NAME}} (nextjs)
  {{SERVICE_NAME}}:
    image: "${{{ENV_PREFIX}}_IMAGE:-{{IMAGE_NAME}}}"
    build:
      context: {{BUILD_CONTEXT_JSON}}
      dockerfile: {{DOCKERFILE_JSON}}
      args:
        GIT_REVISION: ${GIT_REVISION:-current}
        NEXT_PUBLIC_API_BASE_URL: ${{{ENV_PREFIX}}_NEXT_PUBLIC_API_BASE_URL:?{{ENV_PREFIX}}_NEXT_PUBLIC_API_BASE_URL is required}
        NEXT_PUBLIC_MEPRAM_API_BASE_URL: ${{{ENV_PREFIX}}_NEXT_PUBLIC_MEPRAM_API_BASE_URL:?{{ENV_PREFIX}}_NEXT_PUBLIC_MEPRAM_API_BASE_URL is required}
        NEXT_PUBLIC_KEYCLOAK_URL: ${{{ENV_PREFIX}}_NEXT_PUBLIC_KEYCLOAK_URL:?{{ENV_PREFIX}}_NEXT_PUBLIC_KEYCLOAK_URL is required}
        NEXT_PUBLIC_KEYCLOAK_REALM: ${{{ENV_PREFIX}}_NEXT_PUBLIC_KEYCLOAK_REALM:?{{ENV_PREFIX}}_NEXT_PUBLIC_KEYCLOAK_REALM is required}
        NEXT_PUBLIC_KEYCLOAK_CLIENT_ID: ${{{ENV_PREFIX}}_NEXT_PUBLIC_KEYCLOAK_CLIENT_ID:?{{ENV_PREFIX}}_NEXT_PUBLIC_KEYCLOAK_CLIENT_ID is required}
        NEXT_PUBLIC_USE_CASE_DATA_MODE: ${{{ENV_PREFIX}}_NEXT_PUBLIC_USE_CASE_DATA_MODE:?{{ENV_PREFIX}}_NEXT_PUBLIC_USE_CASE_DATA_MODE is required}
        NEXT_PUBLIC_USE_CASE_ALERTS_CONTACT_EMAIL: ${{{ENV_PREFIX}}_NEXT_PUBLIC_USE_CASE_ALERTS_CONTACT_EMAIL:-}
    restart: unless-stopped
    user: "${{{ENV_PREFIX}}_APP_UID:?{{ENV_PREFIX}}_APP_UID is required}:${{{ENV_PREFIX}}_APP_GID:?{{ENV_PREFIX}}_APP_GID is required}"
    environment:
      APP_PORT: ${{{ENV_PREFIX}}_APP_PORT:?{{ENV_PREFIX}}_APP_PORT is required}
      HOSTNAME: 0.0.0.0
      AUTH_SECRET: ${{{ENV_PREFIX}}_AUTH_SECRET:?{{ENV_PREFIX}}_AUTH_SECRET is required}
      AUTH_URL: ${{{ENV_PREFIX}}_AUTH_URL:?{{ENV_PREFIX}}_AUTH_URL is required}
      AUTH_TRUST_HOST: ${{{ENV_PREFIX}}_AUTH_TRUST_HOST:?{{ENV_PREFIX}}_AUTH_TRUST_HOST is required}
      NEXTAUTH_URL: ${{{ENV_PREFIX}}_NEXTAUTH_URL:?{{ENV_PREFIX}}_NEXTAUTH_URL is required}
      PATHOCORE_API_PROXY_TARGET: ${{{ENV_PREFIX}}_PATHOCORE_API_PROXY_TARGET:?{{ENV_PREFIX}}_PATHOCORE_API_PROXY_TARGET is required}
      MEPRAM_OMOP_API_PROXY_TARGET: ${{{ENV_PREFIX}}_MEPRAM_OMOP_API_PROXY_TARGET:?{{ENV_PREFIX}}_MEPRAM_OMOP_API_PROXY_TARGET is required}
    read_only: true
    tmpfs:
      - /tmp:size=16m,mode=1777
      - /app/.next/cache:size=64m,uid=${{{ENV_PREFIX}}_APP_UID:?{{ENV_PREFIX}}_APP_UID is required},gid=${{{ENV_PREFIX}}_APP_GID:?{{ENV_PREFIX}}_APP_GID is required},mode=0750
    healthcheck:
      test: ["CMD-SHELL", "node -e \"require('http').get('http://127.0.0.1:' + process.env.APP_PORT + '/health/',r=>process.exit(r.statusCode<500?0:1)).on('error',()=>process.exit(1))\""]
      interval: 10s
      timeout: 5s
      retries: 12
    ports:
      - "127.0.0.1:${{{ENV_PREFIX}}_APP_PORT:?{{ENV_PREFIX}}_APP_PORT is required}:${{{ENV_PREFIX}}_APP_PORT:?{{ENV_PREFIX}}_APP_PORT is required}"
    networks: [deployment_net]
  # END BU-ISCIII SERVICE: {{SERVICE_NAME}}
