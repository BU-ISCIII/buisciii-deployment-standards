    container_id="$(resolve_service_container {{SERVICE_NAME_SHELL}})"
    [ -n "$container_id" ] || fail "Service {{SERVICE_NAME}} has no container"
    ensure_service_running {{SERVICE_NAME_SHELL}} "$container_id" >/dev/null
    engine_exec exec "$container_id" test -f /app/.next/BUILD_ID
    echo "PASS: {{SERVICE_NAME}} Next.js build exists"
