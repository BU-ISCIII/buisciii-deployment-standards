# syntax=docker/dockerfile:1.4
FROM docker.io/library/node:22-alpine AS build

ARG GIT_REVISION=current
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . ./
RUN npm run build && printf '%s\n' "${GIT_REVISION}" > dist/.deployed_revision

# The unprivileged image listens above 1024 and does not require a root runtime.
FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
COPY scripts/container_start.sh /usr/local/bin/container_start.sh

USER 101:101
EXPOSE {{APP_PORT}}
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:{{APP_PORT}}/ || exit 1
CMD ["/usr/local/bin/container_start.sh"]
