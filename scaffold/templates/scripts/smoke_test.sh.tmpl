#!/usr/bin/env bash
set -euo pipefail

BASE_URL=""
while (($#)); do
    case "$1" in
        --url) BASE_URL="${2:-}"; shift 2 ;;
        --help) echo "Usage: $0 --url <base-url>"; exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done
[[ -n "$BASE_URL" ]] || { echo "--url is required" >&2; exit 1; }

echo "Checking health endpoint"
curl --fail --show-error --silent "${BASE_URL%/}/health/" >/dev/null

echo "Checking application root"
curl --fail --show-error --silent "${BASE_URL%/}/" >/dev/null

# Add authenticated and application-specific acceptance requests here. A useful
# smoke test verifies a real read workflow, not only process availability.
echo "Smoke test passed for $BASE_URL"

