{
  "APP_NAME": "Example Mixed Orchestrator",
  "APP_SLUG": "example-orchestrator",
  "DESCRIPTION": "Django APIs and a React/Vite frontend deployed together.",
  "SERVICES": {
    "api": {
      "PROFILE": "django",
      "BUILD_CONTEXT": "../example-api",
      "DOCKERFILE": "Dockerfile",
      "INSTALL_CONF": "../example-api/conf/docker_production_settings.txt",
      "TEST_INSTALL_CONF": "../example-api/conf/docker_test_settings.txt",
      "PROJECT_MODULE": "example_api"
    },
    "web": {
      "PROFILE": "react-vite",
      "BUILD_CONTEXT": ".",
      "DOCKERFILE": "Dockerfile",
      "INSTALL_CONF": "conf/docker_production_settings.txt",
      "TEST_INSTALL_CONF": "conf/docker_test_settings.txt"
    }
  },
  "ADDONS": {
    "apache": {
      "CONFIG_SERVICE": "web"
    },
    "keycloak": {
      "CONFIG_SERVICE": "web"
    }
  }
}
